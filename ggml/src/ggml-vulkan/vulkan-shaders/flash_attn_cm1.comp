#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(BFLOAT16)
#extension GL_EXT_bfloat16 : enable
#endif

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#include "flash_attn_base.glsl"
#if !defined(BFLOAT16)
#include "flash_attn_dequant.glsl"
#endif

// The coopmatmuladd shape is MatBc x MatBr x MatK (M x N x K). K * Q^T is written transposed so
// its M side runs along KV; P * V has M on the query rows. When MatBc is 8, a subgroup runs two
// M tiles in each, sharing the B operand (Q, V) between them.
const uint32_t MatBr = 16;
const uint32_t MatBc = COOPMAT_M;
const uint32_t MatK = 16;

const uint32_t kv_per_subgroup = Bc / row_split;  // KV rows of K * Q^T per subgroup
const uint32_t k_tiles = kv_per_subgroup / MatBc;
const uint32_t q_tiles = MatBr / MatBc;           // query row tiles of P * V per subgroup

const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;


layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

shared float tmpsh[row_split];

const uint32_t qstride = HSK_pad / 4 + 2;
shared FLOAT_TYPEV4 Qf[Br * qstride];

// P is the A operand of P * V. Intel lowers A loads to dword loads only from row-major memory
// (query rows, KV contiguous), so with an 8-row coopmat Psh is stored that way.
const bool P_ROW_MAJOR = MatBc == 8;
const uint psh_stride = P_ROW_MAJOR ? Bc / 4 + 2 : Br / 4 + 2;
shared FLOAT_TYPEV4 Psh[P_ROW_MAJOR ? Br * psh_stride : Bc * psh_stride];

// Avoid padding for hsk==256 to make it fit in 48KB shmem.
const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
shared ACC_TYPEV4 sfsh[Bc * sfshstride];

const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatK) / 4 + 2;
const uint v_cols = MatBr / 4 * row_split; // total cols, 4 vec4s per MatBr * number of subgroups
const uint vsh_stride = v_cols;
// Size kvsh for the staging this pipeline can actually do; the rest load straight from global
// memory (or, with V_TRANSPOSE, through pvsh). Shared memory limits occupancy on Intel.
// Integer sums, not && / ||: glslang emits invalid SPIR-V for those in a spec-constant array size.
const uint kvsh_need_k = (FaTypeK != GGML_TYPE_F16 ? 1 : 0) + Clamp + (Flags & 16) + HSK % 16 + SHMEM_STAGING;
const uint kvsh_need_v = (FaTypeV != GGML_TYPE_F16 ? 1 : 0) + Clamp + (Flags & 16) + SHMEM_STAGING;
const uint kvsh_k = kvsh_need_k > 0 ? Bc * kvsh_stride : 1;
const uint kvsh_v = kvsh_need_v > 0 ? Bc * (SHMEM_STAGING != 0 ? kvsh_stride : vsh_stride) : 1;
shared FLOAT_TYPEV4 kvsh[kvsh_k >= kvsh_v ? kvsh_k : kvsh_v];

// With V_TRANSPOSE, pvsh doubles as each subgroup's transposed V staging tile (columns
// [gl_SubgroupID * MatBr, +MatBr) of every row). V_TRANSPOSE 1 pads two vec4, keeping the row
// stride 16-byte aligned as coopMatLoad/coopMatStore require; 2 pads one vec4, which avoids
// bank conflicts but is only 8-byte aligned (the host picks it on RADV only).
const uint32_t osh_pad = V_TRANSPOSE == 2 ? 1 : V_TRANSPOSE != 0 ? 2 : 0;
const uint32_t osh_stride = row_split * MatBr / 4 + osh_pad;
const uint vt_tasks4 = MatK / 4 * MatBr / 4;                   // Intel V_TRANSPOSE tasks per chunk
const uint vt_k = (vt_tasks4 + SubGroupSize - 1) / SubGroupSize; // ... per invocation
shared O_TYPEV4 pvsh[MatBr * osh_stride];

shared ACC_TYPE slope[Br];

const uint num_hsv_tiles = (HSV + MatBr * row_split - 1) / (MatBr * row_split); // round up

// Intel: O stays in the P * V accumulators across KV blocks rather than going through pvsh into
// Of every block. M is raised lazily, with headroom, so most blocks need no rescale; when one
// does, the accumulators make a round trip through pvsh, scaled by eMsh.
const bool O_IN_ACC = P_ROW_MAJOR;
shared float eMsh[O_IN_ACC ? Br : 1];
shared uint rescale_sh[O_IN_ACC ? row_split : 1];

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
        init_iq_shmem(gl_WorkGroupSize);
    }
#endif

    init_indices();

    const uint32_t tid = gl_LocalInvocationIndex;

    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t d_per_thread = (HSV/4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t col_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

#define tile_row(r) (row_tid * rows_per_thread + (r))

    // Zero-initialize shared memory for Q/K when HSK is not a multiple of 16 (HSK_pad > HSK).
    if ((HSK % 16) != 0) {
        [[unroll]] for (uint i = 0; i < Br * qstride; i += gl_WorkGroupSize.x) {
            if (i + tid < Br * qstride) {
                Qf[i + tid] = FLOAT_TYPEV4(0);
            }
        }
        barrier();
    }

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;

    [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
        uint32_t d = (idx + tid) % (HSK / 4);
        uint32_t r = (idx + tid) / (HSK / 4);
        if (r < Br && d < HSK / 4 &&
            i * Br + r < N) {
            Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
        }
    }
    barrier();

    O_TYPEV4 Of[rows_per_thread][d_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < d_per_thread; ++d) {
            Of[r][d] = O_TYPEV4(0.0);
        }
    }

    float Lf[rows_per_thread], Mf[rows_per_thread];

    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        if (tid < Br) {
            uint r = tid;
            slope[r] = perElemOpComputeSlope(r, col_tid, ACC_TYPE(0), iq2);
        }
    } else {
        if (tid < Br) {
            uint r = tid;
            slope[r] = ACC_TYPE(1.0);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0
    uint32_t mo_offset = mo_stride * i;

    // FaBlockBytesK/V == 2 for f16 (sizeof f16) and == 16 for f32 (vec4) and == ggml block size for quants.
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / FaBlockBytesK;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    // Built with ifs: folding this into one && chain makes glslang emit an
    // OpSpecConstantOp that references a function-scope OpPhi (invalid SPIR-V).
    bool v_transpose = false;
#if !defined(BFLOAT16)
    if (V_TRANSPOSE != 0 && SHMEM_STAGING == 0 && !V_PRE_T) {
        if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE) {
            v_transpose = true;
        }
    }
#endif
    // Intel with mask-opt: a block that needs its mask starts K * Q^T from slope * mask, staged
    // through sfsh, instead of adding it after (softcap must see S without the mask). Every
    // instruction in the loop costs, even skipped ones: the mask code after K * Q^T was ~7% at
    // the NAR shape although mask-opt runs it for one block in 147.
    bool mask_in_acc = false;
    if (P_ROW_MAJOR && MASK_ENABLE && !LOGIT_SOFTCAP) {
        if (USE_MASK_OPT) {
            mask_in_acc = true;
        }
    }
    // Same ifs as v_transpose.
    bool k_prefetch = false;
    if (P_ROW_MAJOR && SHMEM_STAGING == 0 && HSK % 16 == 0) {
        if (!USE_DECODE_K && !KV_bounds_check && !USE_SPARSE) {
            k_prefetch = true;
        }
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;
    f16vec4 mask_cache[Bc * Br / 4 / WorkGroupSize];

    // P * V accumulators, q_tiles per hsv tile. Without O_IN_ACC each tile's are zeroed and
    // folded into Of every block.
    coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVacc[num_hsv_tiles * q_tiles];
    [[unroll]] for (uint32_t t = 0; t < PVacc.length(); ++t) {
        PVacc[t] = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
    }

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        [[unroll]] for (uint32_t idx = 0; idx < mask_cache.length(); ++idx) {
            mask_cache[idx] = f16vec4(0);
        }

        if (MASK_ENABLE) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                continue;
            }
            // Only load if the block is not all zeros
            if (!mask_in_acc && mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                float max_mask = NEG_FLT_MAX_OVER_2;
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) / (Br / 4);
                    uint32_t r = (idx + tid) % (Br / 4);
                    if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + c, kcol);
                        if (kv_active) {
                            f16vec4 m;
                            if (USE_SPARSE) {
                                // sparse is gqa-gated (m_stride == 0): all four rows share the value
                                FLOAT_TYPE mv = FLOAT_TYPE(data_m[m_offset + kcol]);
                                m = f16vec4(mv);
                                max_mask = max(max_mask, float(mv));
                            } else if (!nem1_bounds_check || i * Br + r * 4 + 3 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 3) * m_stride + (j * Bc + c)]);
                                max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                            } else if (i * Br + r * 4 + 2 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            0.0);
                                max_mask = max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2]));
                            } else if (i * Br + r * 4 + 1 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0);
                                max_mask = max(max(max_mask, float(m[0])), float(m[1]));
                            } else if (i * Br + r * 4 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0,
                                            0.0);
                                max_mask = max(max_mask, float(m[0]));
                            } else {
                                m = f16vec4(0.0);
                            }
                            mask_cache[idx / WorkGroupSize] = m;
                        } else if (USE_SPARSE) {
                            mask_cache[idx / WorkGroupSize] = f16vec4(NEG_FLT_MAX_OVER_2);
                        }
                    }
                }
                // skip the block if the mask is entirely -inf
                bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSK_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSK_pad / 4);
                uint32_t c = (idx + tid) / (HSK_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSK_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                    uint32_t kcol;
                    bool kv_active = fa_kv_index(j * Bc + c, kcol);
                    if (kv_active && (HSK == HSK_pad || d < HSK / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_K) {
                            uint coord = kcol * k_stride * BLOCK_SIZE_K + 4 * d;
                            uint ib = coord / BLOCK_SIZE_K;
                            uint iqs = (coord % BLOCK_SIZE_K);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                        } else
#endif
                        {
                            K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = K_Tf;
                }
            }
            barrier();
        }

        // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
        // Bc split across workgroup (row_split subgroups, k_tiles M tiles each), loop over HSK in
        // chunks of MatK: MatBc x 16 * 16 x 16 -> MatBc x 16
        // This is written transposed in order to allow for N being 8 if implementations need it
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat[k_tiles];
        [[unroll]] for (uint32_t t = 0; t < k_tiles; ++t) {
            SfMat[t] = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        }
        if (mask_in_acc && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            // The previous block's softmax is done with sfsh; this also orders the slope writes.
            barrier();
            // Not unrolled: this runs for few blocks, and the loop's code size costs every block.
            [[dont_unroll]] for (uint32_t idx = tid; idx < Bc * Br; idx += gl_WorkGroupSize.x) {
                const uint c = idx % Bc;
                const uint r = idx / Bc;
                ACC_TYPE m = ACC_TYPE(0);
                if ((!KV_bounds_check || j * Bc + c < KV) && (p.gqa_ratio > 1 || i * Br + r < p.nem1)) {
                    m = slope[r] * ACC_TYPE(data_m[m_offset + (i * Br + r) * m_stride + j * Bc + c]);
                }
                sfsh[c * sfshstride + r / 4][r % 4] = m;
            }
            barrier();
            [[unroll]] for (uint32_t t = 0; t < k_tiles; ++t) {
                const uint coord = (gl_SubgroupID * kv_per_subgroup + t * MatBc) * sfshstride;
                coopMatLoad(SfMat[t], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, MatK, gl_MatrixUseA> KMat;
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatK, MatBr, gl_MatrixUseB> QMat;

        // Intel: K tiles for the next d step are loaded while this one multiplies.
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, MatK, gl_MatrixUseA> KNext[k_tiles];
#define LOAD_K_NEXT(dd, t) \
    coopMatLoad(KNext[t], data_kv4, k_offset / 4 + (j * Bc + gl_SubgroupID * kv_per_subgroup + (t) * MatBc) * k_stride / 4 + (dd) * MatK / 4, \
                k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
        if (k_prefetch) {
            [[unroll]] for (uint32_t t = 0; t < k_tiles; ++t) {
                LOAD_K_NEXT(0, t)
            }
        }

        [[unroll]] for (uint32_t d = 0; d < HSK_pad / MatK; ++d) {
            // If SHMEM_STAGING is set, a Bc * HSK_pad size tile of K is loaded to shmem
            // If not, K is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatK size staging buffer.
            // If K is a quant type, then it is always staged for dequantization.
            // For quants we always need to dequant into kvsh; for f16/bf16 we can load
            // directly from global memory when alignment / bounds allow it.
            const bool stage_k = SHMEM_STAGING == 0 && (USE_DECODE_K || KV_bounds_check || USE_SPARSE || d * MatK + MatK > HSK);
            if (stage_k) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * MatK / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t col_vec = (idx + tid) % (MatK / 4);
                    uint32_t row = (idx + tid) / (MatK / 4);
                    if (idx + tid < Bc * MatK / 4) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + row, kcol);
                        if (kv_active && (HSK == HSK_pad || d * MatK + col_vec * 4 < HSK)) {
#if !defined(BFLOAT16)
                            if (USE_DECODE_K) {
                                uint coord = kcol * k_stride * BLOCK_SIZE_K + d * MatK + col_vec * 4;
                                uint ib = coord / BLOCK_SIZE_K;
                                uint iqs = (coord % BLOCK_SIZE_K);
                                K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                            } else
#endif
                            {
                                K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d * MatK / 4 + col_vec]);
                            }
                        }

                        kvsh[row * kvsh_stride + col_vec] = K_Tf;
                    }
                }
                barrier();
            }

            // Load order matters to both compilers: RADV wants the K load first so its latency
            // overlaps the Q load, Intel (P_ROW_MAJOR) is ~3% faster with Q first.
            [[unroll]] for (uint32_t t = 0; t < k_tiles; ++t) {
                if (P_ROW_MAJOR && t == 0) {
                    coopMatLoad(QMat, Qf, d * MatK / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                }
                const uint kv_row = gl_SubgroupID * kv_per_subgroup + t * MatBc;
                if (k_prefetch) {
                    KMat = KNext[t];
                    if (d + 1 < HSK_pad / MatK) {
                        LOAD_K_NEXT(d + 1, t)
                    }
                } else if (SHMEM_STAGING != 0) {
                    coopMatLoad(KMat, kvsh, kv_row * kvsh_stride + d * MatK / 4, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                } else if (stage_k) {
                    coopMatLoad(KMat, kvsh, kv_row * kvsh_stride, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                } else {
                    const uint coord = k_offset / 4 + (j * Bc + kv_row) * k_stride / 4 + d * MatK / 4;
                    coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                }
                if (!P_ROW_MAJOR && t == 0) {
                    coopMatLoad(QMat, Qf, d * MatK / 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                }

                SfMat[t] = coopMatMulAdd(KMat, QMat, SfMat[t]);
            }
        }

        [[unroll]] for (uint32_t t = 0; t < k_tiles; ++t) {
            const uint coord = (gl_SubgroupID * kv_per_subgroup + t * MatBc) * sfshstride;
            coopMatStore(SfMat[t], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && !mask_in_acc && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    if (!KV_bounds_check || j * Bc + c < KV) {
                        // Mask nem1 bounds check is handled when loading masks
                        ACC_TYPEV4 masks = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]);
                        ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4], slope[r * 4 + 1], slope[r * 4 + 2], slope[r * 4 + 3]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        float eMf[rows_per_thread];
        bool rescale = false;  // O_IN_ACC: M moved for one of this subgroup's rows
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint r_vec  = tile_row(r) / 4;
            const uint r_comp = tile_row(r) % 4;

            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                if (KV_bounds_check && j * Bc + c * cols_per_iter + col_tid >= KV) {
                    continue;
                }
                rowmaxf = max(rowmaxf, float(sfsh[r_vec + (c * cols_per_iter + col_tid) * sfshstride][r_comp]));
            }
            rowmaxf += FATTN_KQ_MAX_OFFSET;
            float Moldf = Mf[r];

            // Compute max across the row
            rowmaxf = subgroupMax(rowmaxf);

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            if (O_IN_ACC) {
                // Keep M while P stays <= e^-FATTN_KQ_MAX_OFFSET, as above; when it must move,
                // move it one more offset so the next blocks can keep it.
                if (rowmaxf > Moldf) {
                    Mf[r] = rowmaxf + FATTN_KQ_MAX_OFFSET;
                    rescale = true;
                }
            } else {
                Mf[r] = max(rowmaxf, Moldf);
            }
            eMf[r] = exp(Moldf - Mf[r]);

            Lf[r] = eMf[r]*Lf[r];
            if (O_IN_ACC && col_tid == 0) {
                eMsh[tile_row(r)] = eMf[r];
            }
        }

        if (O_IN_ACC) {
            if (gl_SubgroupInvocationID == 0) {
                rescale_sh[gl_SubgroupID] = rescale ? 1 : 0;
            }
        } else {
            [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                const uint d_local = d0 / threads_per_rowgroup;
                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                    Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
                }
            }
        }

        // Calculate and store Pf in Psh
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            const uint col = c * cols_per_iter + col_tid;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; r += 4) {
                const uint row = tile_row(r);
                if (KV_bounds_check && j * Bc + col >= KV) {
                    if (P_ROW_MAJOR) {
                        [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                            Psh[(row + vec_idx) * psh_stride + col / 4][col % 4] = FLOAT_TYPE(0.0f);
                        }
                    } else {
                        Psh[col * psh_stride + row / 4] = FLOAT_TYPEV4(0.0f);
                    }
                } else {
                    const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
                    const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                    [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                        Lf[r + vec_idx] += Pf[vec_idx];
                    }
                    if (P_ROW_MAJOR) {
                        [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                            Psh[(row + vec_idx) * psh_stride + col / 4][col % 4] = Pf[vec_idx];
                        }
                    } else {
                        Psh[col * psh_stride + row / 4] = Pf;
                    }
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSV_pad / 4);
                uint32_t c = (idx + tid) / (HSV_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + c, v_row);
                    if (kv_active && (HSV == HSV_pad || d < HSV / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            uint coord = v_row * v_stride * BLOCK_SIZE_V + 4 * d;
                            uint ib = coord / BLOCK_SIZE_V;
                            uint iqs = (coord % BLOCK_SIZE_V);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + v_row * v_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = V_Tf;
                }
            }
        }
        barrier();

        uint any_rescale = 0;
        if (O_IN_ACC) {
            [[unroll]] for (uint32_t s = 0; s < row_split; ++s) {
                any_rescale |= rescale_sh[s];
            }
        }
        // Built with ifs, like v_transpose.
        bool stage_v = false;
        if (SHMEM_STAGING == 0) {
            if (USE_DECODE_V || KV_bounds_check || USE_SPARSE) {
                stage_v = true;
            }
        }
        bool tile_barrier = stage_v;
        if (!O_IN_ACC) {
            tile_barrier = true;
        }

        // Each subgroup handles HSV/4 columns
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * MatBr;

#define PVMat(qt) PVacc[hsv_tile * q_tiles + (qt)]
            if (!O_IN_ACC) {
                [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                    PVMat(qt) = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
                }
            }

            // Preload V tiles for [Bc, MatBr * num subgroups]
            const uint v_rows = Bc;
            const uint v_total = v_rows * v_cols;
            const uint v_loads_per_thread = v_total / gl_WorkGroupSize.x;

            // If SHMEM_STAGING is set, a Bc * HSV_pad size tile of V is loaded to shmem.
            // If not, V is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If V is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always preload via kvsh. For f16/bf16 we only preload when
            // alignment / bounds force it (otherwise we coopMatLoad direct from data_vv4).
            if (stage_v) {
                [[unroll]] for (uint32_t i = 0; i < v_loads_per_thread; ++i) {
                    const uint idx = i * gl_WorkGroupSize.x + tid;
                    const uint row = idx / v_cols;
                    const uint col = idx % v_cols;

                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + row, v_row);
                    const uint v_col = hsv_tile * MatBr * row_split + col * 4;

                    const uint coord = v_row * v_stride * BLOCK_SIZE_V + v_col;
                    const uint ib = coord / BLOCK_SIZE_V;
                    const uint iqs = coord % BLOCK_SIZE_V;

                    if (USE_SPARSE ? (kv_active && v_col < HSV) : (!KV_bounds_check || (v_row < KV && v_col < HSV))) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            kvsh[row * vsh_stride + col] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            kvsh[row * vsh_stride + col] = data_vv4[(v_offset + v_row * v_stride + v_col) / 4];
                        }
                    } else {
                        kvsh[row * vsh_stride + col] = FLOAT_TYPEV4(0.0f);
                    }
                }
            }
            }
            // O_IN_ACC: subgroups only touch their own pvsh columns, so only kvsh staging needs it.
            if (tile_barrier) {
                barrier();
            }

            const uint o_offset = gl_SubgroupID * MatBr / 4;

            if (hsv_offset < HSV_pad) {
                if (O_IN_ACC && any_rescale != 0) {
                    // Scale this subgroup's O columns, all Br rows, by e^(Mold - M) via pvsh.
                    [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                        coopMatStore(PVMat(qt), pvsh, o_offset + qt * MatBc * osh_stride, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    subgroupBarrier();
                    [[unroll]] for (uint32_t idx = gl_SubgroupInvocationID; idx < Br * MatBr / 4; idx += gl_SubgroupSize) {
                        const uint row = idx / (MatBr / 4);
                        pvsh[row * osh_stride + o_offset + idx % (MatBr / 4)] *= O_TYPE(eMsh[row]);
                    }
                    subgroupBarrier();
                    [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                        coopMatLoad(PVMat(qt), pvsh, o_offset + qt * MatBc * osh_stride, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    subgroupBarrier();
                }
                if (V_PRE_T) {
                    continue;
                }
                // Intel V_TRANSPOSE: a task is 4 kv rows x one vec4 of d, held in registers so the
                // next chunk's loads are in flight while this chunk multiplies.
                FLOAT_TYPEV4 vr[vt_k][4];
#define LOAD_VT(chunk) \
    [[unroll]] for (uint32_t k = 0; k < vt_k; ++k) { \
        const uint t = k * gl_SubgroupSize + gl_SubgroupInvocationID; \
        if (t < vt_tasks4) { \
            const uint vrow = v_offset / 4 + (j * Bc + (chunk) * MatK + 4 * (t / (MatBr / 4))) * v_stride / 4 + hsv_offset / 4 + t % (MatBr / 4); \
            [[unroll]] for (uint32_t r = 0; r < 4; ++r) { \
                vr[k][r] = data_vv4[vrow + r * v_stride / 4]; \
            } \
        } \
    }
                if (v_transpose && P_ROW_MAJOR) {
                    LOAD_VT(0)
                }
                // P rows of query tile qt, columns of this KV chunk
#define LOAD_P(qt) \
    if (P_ROW_MAJOR) { \
        coopMatLoad(KMat, Psh, (qt) * MatBc * psh_stride + bc_chunk * MatK / 4, psh_stride, gl_CooperativeMatrixLayoutRowMajor); \
    } else { \
        coopMatLoad(KMat, Psh, bc_chunk * MatK * psh_stride + (qt) * MatBc / 4, psh_stride, gl_CooperativeMatrixLayoutColumnMajor); \
    }
                [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatK; ++bc_chunk) {
                    // Same story as K/Q: P before V on RADV, V first on Intel.
                    if (!P_ROW_MAJOR) {
                        LOAD_P(0)
                    }

                    if (SHMEM_STAGING == 0) {
#if !defined(BFLOAT16)
                    if (v_transpose) {
                        // V is kv x d row-major, but the B operand wants each column's kv values
                        // contiguous. Load the MatK x MatBr tile with wide loads, store it transposed
                        // into this subgroup's pvsh columns, then load it column-major.
                        // A task is two adjacent kv rows x one vec4 of d, so each d column gets a
                        // packed 32-bit store of its (kv, kv + 1) pair. k < 4 covers subgroups
                        // down to 8 invocations.
                        const uint v_tile_row = j * Bc + bc_chunk * MatK;
                        const uint vt_tasks = MatK / 2 * MatBr / 4;

                        if (bc_chunk > 0) {
                            subgroupBarrier();
                        }
                        if (P_ROW_MAJOR) {
                            // Intel lowers 16-bit shared stores one element at a time: store one
                            // transposed vec4 (4 kv) per d column, then start the next chunk's loads.
                            [[unroll]] for (uint32_t k = 0; k < vt_k; ++k) {
                                const uint t = k * gl_SubgroupSize + gl_SubgroupInvocationID;
                                if (t < vt_tasks4) {
                                    [[unroll]] for (uint32_t e = 0; e < 4; ++e) {
                                        pvsh[(t % (MatBr / 4) * 4 + e) * osh_stride + o_offset + t / (MatBr / 4)] =
                                            O_TYPEV4(vr[k][0][e], vr[k][1][e], vr[k][2][e], vr[k][3][e]);
                                    }
                                }
                            }
                            if (bc_chunk + 1 < Bc / MatK) {
                                LOAD_VT(bc_chunk + 1)
                            }
                        } else
                        [[unroll]] for (uint32_t k = 0; k < 4; ++k) {
                            const uint t = k * gl_SubgroupSize + gl_SubgroupInvocationID;
                            if (k * gl_SubgroupSize < vt_tasks && t < vt_tasks) {
                                const uint pr = t % (MatK / 2);
                                const uint dv = t / (MatK / 2);
                                const uint vrow = v_offset / 4 + (v_tile_row + 2 * pr) * v_stride / 4 + hsv_offset / 4 + dv;
                                const FLOAT_TYPEV4 v0 = data_vv4[vrow];
                                const FLOAT_TYPEV4 v1 = data_vv4[vrow + v_stride / 4];
                                [[unroll]] for (uint32_t e = 0; e < 4; ++e) {
                                    const uint idx = (dv * 4 + e) * osh_stride + o_offset + pr / 2;
                                    pvsh[idx][(pr % 2) * 2]     = v0[e];
                                    pvsh[idx][(pr % 2) * 2 + 1] = v1[e];
                                }
                            }
                        }
                        subgroupBarrier();
                        coopMatLoad(QMat, pvsh, o_offset, osh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                    } else
#endif
                    if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE) {
                        // F16/BF16 values can be loaded directly from global memory
                        const uint v_tile_row = j * Bc + bc_chunk * MatK;
                        const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
                        coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                    } else {
                        const uint v_tile_offset = bc_chunk * MatK * v_cols + gl_SubgroupID * (MatBr / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    } else {
                        const uint v_tile_offset = bc_chunk * MatK * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBr / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }

                    [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                        if (P_ROW_MAJOR || qt > 0) {
                            LOAD_P(qt)
                        }
                        PVMat(qt) = coopMatMulAdd(KMat, QMat, PVMat(qt));
                    }
                }

                if (v_transpose) {
                    // The last V tile load must finish before PVMat overwrites the region.
                    subgroupBarrier();
                }
                if (!O_IN_ACC) {
                    // Store PVMat to pvsh and load into Of
                    [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                        coopMatStore(PVMat(qt), pvsh, o_offset + qt * MatBc * osh_stride, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
            }

            if (O_IN_ACC) {
                if (stage_v) {
                    // The next tile restages kvsh.
                    barrier();
                }
                continue;
            }
            barrier();

            const uint hsv_per_tile = row_split * MatBr;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            const uint d_values_per_tile = hsv_per_tile / 4;

            const uint d_start = hsv_tile * d_values_per_tile;
            const uint d_end = min(d_start + d_values_per_tile, HSV / 4);

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);

                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint d = d_local * threads_per_rowgroup + col_tid;
                    const uint hsv_col = 4 * d;

                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        const uint local_hsv = (hsv_col - hsv_base) / 4;
                        Of[r][d_local] += pvsh[row * osh_stride + local_hsv];
                    }
                }
            }
        }

        if (V_PRE_T) {
            // KV chunk outer, hsv tiles inner: each P tile is loaded once for all of them.
            [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatK; ++bc_chunk) {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, MatK, gl_MatrixUseA> PMat[q_tiles];
                [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
                    const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * MatBr;
                    if (hsv_offset < HSV_pad) {
                        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatK, MatBr, gl_MatrixUseB> VMat;
                        coopMatLoad(VMat, data_vv4, v_offset / 4 + (hsv_offset * v_stride + j * Bc + bc_chunk * MatK) / 4,
                                    v_stride / 4, gl_CooperativeMatrixLayoutColumnMajor);
                        if (hsv_tile == 0) {
                            [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                                coopMatLoad(PMat[qt], Psh, qt * MatBc * psh_stride + bc_chunk * MatK / 4, psh_stride, gl_CooperativeMatrixLayoutRowMajor);
                            }
                        }
                        [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                            PVacc[hsv_tile * q_tiles + qt] = coopMatMulAdd(PMat[qt], VMat, PVacc[hsv_tile * q_tiles + qt]);
                        }
                    }
                }
            }
        }

        // V_PRE_T stages nothing in kvsh, and the next block's first shared writes (sfsh, then
        // Psh, eMsh, rescale_sh) all come after its K * Q^T barrier.
        if (!V_PRE_T) {
            barrier();
        }
    }

    if (O_IN_ACC) {
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint o_offset = gl_SubgroupID * MatBr / 4;
            if ((hsv_tile * row_split + gl_SubgroupID) * MatBr < HSV_pad) {
                [[unroll]] for (uint32_t qt = 0; qt < q_tiles; ++qt) {
                    coopMatStore(PVacc[hsv_tile * q_tiles + qt], pvsh, o_offset + qt * MatBc * osh_stride, osh_stride, gl_CooperativeMatrixLayoutRowMajor);
                }
            }
            barrier();

            const uint hsv_per_tile = row_split * MatBr;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint hsv_col = 4 * (d_local * threads_per_rowgroup + col_tid);
                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        Of[r][d_local] = pvsh[row * osh_stride + (hsv_col - hsv_base) / 4];
                    }
                }
            }
            barrier();
        }
    }

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = subgroupAdd(Lf[r]);
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2.
            uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                    }
                }
            }

            o_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        data_ov4[o_offset + iq2 * HSV/4 + d] = D_TYPEV4(Of[r][d/threads_per_rowgroup]);
                    }
                }

                if (global_row < N && col_tid == 0) {
                    uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                    data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                    data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                }
            }
        }

        return;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float sink = perElemOpGetSink(tile_row(r), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[r]) {
                ms = exp(Mf[r] - sink);

                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d_local = d0 / threads_per_rowgroup;
                    Of[r][d_local] *= O_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[r]);
            }

            Lf[r] = Lf[r]*ms + vs;
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lfrcp[r] = (Lf[r] == 0.0) ? 0.0 : (1.0 / Lf[r]);
    }

    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
        const uint d_local = d0 / threads_per_rowgroup;
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d_local] *= O_TYPE(Lfrcp[r]);
#if defined(FLOAT_TYPE_MAX)
            Of[r][d_local] = clamp(Of[r][d_local], -FLOAT_TYPE_MAX, FLOAT_TYPE_MAX);
#endif
        }
    }

    uint32_t o_offset = (gqa_iq1*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;

    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (i * Br + tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[o_offset + (iq2 * HSV + (i * Br + tile_row(r)) * p.ne1 * HSV) / 4 + d] = D_TYPEV4(Of[r][d_local]);
                }
            }
        }
    }
}
